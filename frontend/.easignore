# EAS Build ignore file
# Exclude corrupted or problematic files

# Cache directories
.metro-cache/
.expo/
.ruff_cache/
dist/
web-build/

# Node modules (will be reinstalled)
node_modules/

# Build artifacts
*.tsbuildinfo
*.orig.*

# macOS artifacts
.DS_Store
*.swp
*~

# Debug files
npm-debug.*
yarn-debug.*
yarn-error.*

# Sensitive files (should not be in builds)
*.p8
*.p12
*.key
*.mobileprovision
*.jks
credentials.json

# Test files
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/

# Documentation
*.md
!README.md

# IDE files
.vscode/
.idea/

# Files with non-ASCII characters (corrupted files)
*[^a-zA-Z0-9._/-]*
