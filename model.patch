+            "test": test_name,
+            "status": status,
+            "success": success,
+            "details": details,
+            "response_code": response_code
+        }
+        self.results.append(result)
+        print(f"{status} {test_name}")
+        if details:
+            print(f"    {details}")
+        if response_code:
+            print(f"    Response Code: {response_code}")
+        print()
+
